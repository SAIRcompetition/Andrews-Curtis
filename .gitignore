# Track only the public competition tree and root documentation.
/*
!/.gitignore
!/LICENSE
!/README.md
!/competition/

# Local notice copy
/competition/NOTICE

# Generated competition metadata
/competition/competition.yaml

# Python
__pycache__/
*.pyc
.pytest_cache/

# Lean / Lake generated files
.lake/
/competition/tools/lean/lake-manifest.json

# Optional local proof checks
/competition/tools/lean/Check.lean
/competition/tools/lean/statement-lock.json

# macOS
.DS_Store
